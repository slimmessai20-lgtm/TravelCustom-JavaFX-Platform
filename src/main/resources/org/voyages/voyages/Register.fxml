<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.Register"
            prefHeight="600.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom, #4CAF50, #388E3C);">

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 5);">
            <VBox.margin>
                <Insets top="40" right="50" bottom="40" left="50"/>
            </VBox.margin>

            <!-- Header -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="✈️" style="-fx-font-size: 48px;"/>
                <Label text="Créer un compte" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
                <Label text="Rejoignez-nous pour organiser vos voyages" style="-fx-font-size: 14px; -fx-text-fill: #757575;"/>
            </VBox>

            <Separator prefWidth="300"/>

            <!-- Formulaire -->
            <VBox spacing="15" alignment="CENTER" style="-fx-padding: 0 30 0 30;">

                <!-- Nom -->
                <VBox spacing="5">
                    <Label text="Nom complet :" style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                    <TextField fx:id="txtNom" promptText="Votre nom complet"
                               prefWidth="350" prefHeight="40"
                               style="-fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #E0E0E0; -fx-border-radius: 5;"/>
                </VBox>

                <!-- Email -->
                <VBox spacing="5">
                    <Label text="Email :" style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                    <TextField fx:id="txtEmail" promptText="votre@email.com"
                               prefWidth="350" prefHeight="40"
                               style="-fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #E0E0E0; -fx-border-radius: 5;"/>
                </VBox>

                <!-- Mot de passe -->
                <VBox spacing="5">
                    <Label text="Mot de passe :" style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                    <PasswordField fx:id="txtPassword" promptText="Minimum 6 caractères"
                                   prefWidth="350" prefHeight="40"
                                   style="-fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #E0E0E0; -fx-border-radius: 5;"/>
                </VBox>

                <!-- Confirmation mot de passe -->
                <VBox spacing="5">
                    <Label text="Confirmer le mot de passe :" style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                    <PasswordField fx:id="txtConfirmPassword" promptText="Retapez votre mot de passe"
                                   prefWidth="350" prefHeight="40"
                                   style="-fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #E0E0E0; -fx-border-radius: 5;"/>
                </VBox>

                <!-- Message d'erreur -->
                <Label fx:id="lblMessage" style="-fx-text-fill: #f44336; -fx-font-size: 13px; -fx-font-weight: bold;"/>

                <!-- Bouton Inscription -->
                <Button fx:id="btnRegister" text="S'inscrire" onAction="#handleRegister"
                        prefWidth="350" prefHeight="45"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Button>

                <!-- Lien Retour Connexion -->
                <HBox alignment="CENTER" spacing="5">
                    <Label text="Vous avez déjà un compte ?" style="-fx-font-size: 13px; -fx-text-fill: #757575;"/>
                    <Hyperlink fx:id="linkLogin" text="Se connecter" onAction="#handleBackToLogin"
                               style="-fx-font-size: 13px; -fx-text-fill: #4CAF50; -fx-underline: true;"/>
                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>

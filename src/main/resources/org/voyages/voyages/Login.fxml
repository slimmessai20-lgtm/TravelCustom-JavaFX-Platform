<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.Login"
            prefHeight="500.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom, #2196F3, #1976D2);">

    <center>
        <VBox alignment="CENTER" spacing="25" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 5);">
            <VBox.margin>
                <Insets top="50" right="50" bottom="50" left="50"/>
            </VBox.margin>

            <!-- Header -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="🌍" style="-fx-font-size: 48px;"/>
                <Label text="Gestion de Voyages" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
                <Label text="Connexion" style="-fx-font-size: 16px; -fx-text-fill: #757575;"/>
            </VBox>

            <Separator prefWidth="300"/>

            <!-- Formulaire -->
            <VBox spacing="20" alignment="CENTER" style="-fx-padding: 0 30 0 30;">

                <!-- Email -->
                <VBox spacing="5">
                    <Label text="Email :" style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                    <TextField fx:id="txtEmail" promptText="votre@email.com"
                               prefWidth="350" prefHeight="40"
                               style="-fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #E0E0E0; -fx-border-radius: 5;"/>
                </VBox>

                <!-- Mot de passe -->
                <VBox spacing="5">
                    <Label text="Mot de passe :" style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                    <PasswordField fx:id="txtPassword" promptText="••••••••"
                                   prefWidth="350" prefHeight="40"
                                   style="-fx-font-size: 14px; -fx-background-radius: 5; -fx-border-color: #E0E0E0; -fx-border-radius: 5;"/>
                </VBox>

                <!-- Message d'erreur -->
                <Label fx:id="lblMessage" style="-fx-text-fill: #f44336; -fx-font-size: 13px; -fx-font-weight: bold;"/>

                <!-- Bouton Connexion -->
                <Button fx:id="btnLogin" text="Se connecter" onAction="#handleLogin"
                        prefWidth="350" prefHeight="45"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Button>

                <!-- Lien Inscription -->
                <HBox alignment="CENTER" spacing="5">
                    <Label text="Pas encore de compte ?" style="-fx-font-size: 13px; -fx-text-fill: #757575;"/>
                    <Hyperlink fx:id="linkRegister" text="S'inscrire" onAction="#handleRegister"
                               style="-fx-font-size: 13px; -fx-text-fill: #2196F3; -fx-underline: true;"/>
                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>

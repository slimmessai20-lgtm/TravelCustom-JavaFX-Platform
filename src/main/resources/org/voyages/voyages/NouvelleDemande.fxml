<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.NouvelleDemande"
            prefHeight="500.0" prefWidth="600.0"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: #4CAF50; -fx-padding: 20;">
            <Label text="Nouvelle Demande de Voyage" textFill="WHITE">
                <font><Font name="System Bold" size="20"/></font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: white;" alignment="TOP_CENTER">
            <GridPane hgap="15" vgap="15" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints minWidth="150" prefWidth="150"/>
                    <ColumnConstraints minWidth="300" prefWidth="350"/>
                </columnConstraints>

                <!-- Destination -->
                <Label text="Destination :" GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <font><Font size="14"/></font>
                </Label>
                <TextField fx:id="txtDestination" promptText="Ex: Paris, Tokyo, New York..."
                           GridPane.rowIndex="0" GridPane.columnIndex="1"
                           style="-fx-font-size: 14px;"/>

                <!-- Date Début -->
                <Label text="Date de début :" GridPane.rowIndex="1" GridPane.columnIndex="0">
                    <font><Font size="14"/></font>
                </Label>
                <DatePicker fx:id="dateDebut" GridPane.rowIndex="1" GridPane.columnIndex="1"
                            promptText="Sélectionner la date de départ"
                            style="-fx-font-size: 14px;"/>

                <!-- Date Fin -->
                <Label text="Date de fin :" GridPane.rowIndex="2" GridPane.columnIndex="0">
                    <font><Font size="14"/></font>
                </Label>
                <DatePicker fx:id="dateFin" GridPane.rowIndex="2" GridPane.columnIndex="1"
                            promptText="Sélectionner la date de retour"
                            style="-fx-font-size: 14px;"/>

                <!-- Préférences -->
                <Label text="Préférences :" GridPane.rowIndex="3" GridPane.columnIndex="0"
                       GridPane.valignment="TOP">
                    <font><Font size="14"/></font>
                    <GridPane.margin><Insets top="5"/></GridPane.margin>
                </Label>
                <TextArea fx:id="txtPreferences"
                          promptText="Budget, type d'hébergement, activités souhaitées, allergies alimentaires, etc."
                          wrapText="true" prefRowCount="5"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"
                          style="-fx-font-size: 13px;"/>
            </GridPane>

            <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Button text="Soumettre la demande" onAction="#handleSoumettre"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 30; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Button text="Annuler" onAction="#handleAnnuler"
                        style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 30; -fx-cursor: hand;"/>
            </HBox>

            <Label fx:id="lblMessage" style="-fx-text-fill: red; -fx-font-size: 12px;"/>
        </VBox>
    </center>

</BorderPane>


<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.NouvelleReservation"
            prefHeight="400.0" prefWidth="500.0"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: #4CAF50; -fx-padding: 20;">
            <Label text="Créer une Réservation" textFill="WHITE">
                <font><Font name="System Bold" size="20"/></font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: white;">

            <!-- Informations de la demande -->
            <VBox spacing="10" style="-fx-background-color: #E3F2FD; -fx-padding: 15; -fx-background-radius: 5;">
                <Label text="Informations de la demande" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label fx:id="lblDemandeInfo" wrapText="true" style="-fx-font-size: 12px;"/>
            </VBox>

            <GridPane hgap="15" vgap="15">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="120"/>
                    <ColumnConstraints minWidth="250" prefWidth="300"/>
                </columnConstraints>

                <!-- Prix Total -->
                <Label text="Prix Total (DT) :" GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <font><Font size="14"/></font>
                </Label>
                <TextField fx:id="txtPrixTotal" promptText="Ex: 1500.00"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"
                           style="-fx-font-size: 14px;"/>

                <!-- Statut -->
                <Label text="Statut :" GridPane.rowIndex="1" GridPane.columnIndex="0">
                    <font><Font size="14"/></font>
                </Label>
                <ComboBox fx:id="comboStatut" GridPane.rowIndex="1" GridPane.columnIndex="1"
                          prefWidth="300" style="-fx-font-size: 14px;">
                </ComboBox>

            </GridPane>

            <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Button text="Créer la réservation" onAction="#handleCreer"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 30; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Button text="Annuler" onAction="#handleAnnuler"
                        style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 30; -fx-cursor: hand;"/>
            </HBox>

            <Label fx:id="lblMessage" style="-fx-text-fill: red; -fx-font-size: 12px;"/>
        </VBox>
    </center>

</BorderPane>


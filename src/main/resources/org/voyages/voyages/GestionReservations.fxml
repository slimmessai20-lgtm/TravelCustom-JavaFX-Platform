<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.GestionReservations"
            prefHeight="600.0" prefWidth="1000.0"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: #4CAF50; -fx-padding: 20;">
            <Label text="Gestion des Réservations" textFill="WHITE">
                <font><Font name="System Bold" size="20"/></font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <HBox spacing="10">
                <Button text="🔄 Actualiser" onAction="#handleActualiser"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;"/>
                <Button text="🗑 Supprimer" onAction="#handleSupprimer"
                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="comboFiltre" promptText="Filtrer par statut" onAction="#handleFiltrer"/>
            </HBox>

            <TableView fx:id="tableViewReservations" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colClient" text="Client" prefWidth="150"/>
                    <TableColumn fx:id="colDestination" text="Destination" prefWidth="150"/>
                    <TableColumn fx:id="colAgent" text="Agent" prefWidth="120"/>
                    <TableColumn fx:id="colPrix" text="Prix Total (DT)" prefWidth="120"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
                    <TableColumn fx:id="colDateRes" text="Date Réservation" prefWidth="180"/>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DashboardAdmin"
            prefHeight="700.0" prefWidth="1000.0"
            style="-fx-background-color: #f5f5f5;">

    <!-- Header -->
    <top>
        <VBox style="-fx-background-color: #FF5722; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Tableau de Bord - Administrateur" textFill="WHITE">
                    <font><Font name="System Bold" size="24"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblNomAdmin" text="Admin" textFill="WHITE">
                    <font><Font size="14"/></font>
                </Label>
                <Button text="Déconnexion" onAction="#handleLogout"
                        style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="25" style="-fx-padding: 30;">

            <!-- Statistiques en cartes -->
            <Label text="Statistiques Globales" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                </columnConstraints>

                <!-- Card Utilisateurs -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);"
                      GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="👥" style="-fx-font-size: 40px;"/>
                    <Label fx:id="lblTotalUtilisateurs" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #FF5722;"/>
                    <Label text="Total Utilisateurs" style="-fx-font-size: 14px; -fx-text-fill: #757575;"/>
                </VBox>

                <!-- Card Clients -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);"
                      GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="🧳" style="-fx-font-size: 40px;"/>
                    <Label fx:id="lblTotalClients" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
                    <Label text="Clients" style="-fx-font-size: 14px; -fx-text-fill: #757575;"/>
                </VBox>

                <!-- Card Agents -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);"
                      GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="👨‍💼" style="-fx-font-size: 40px;"/>
                    <Label fx:id="lblTotalAgents" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #673AB7;"/>
                    <Label text="Agents" style="-fx-font-size: 14px; -fx-text-fill: #757575;"/>
                </VBox>

                <!-- Card Demandes -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);"
                      GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="📋" style="-fx-font-size: 40px;"/>
                    <Label fx:id="lblTotalDemandes" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
                    <Label text="Total Demandes" style="-fx-font-size: 14px; -fx-text-fill: #757575;"/>
                </VBox>

                <!-- Card Demandes en attente -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);"
                      GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="⏳" style="-fx-font-size: 40px;"/>
                    <Label fx:id="lblDemandesEnAttente" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #FFC107;"/>
                    <Label text="En Attente" style="-fx-font-size: 14px; -fx-text-fill: #757575;"/>
                </VBox>

                <!-- Card Réservations -->
                <VBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);"
                      GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <Label text="✈️" style="-fx-font-size: 40px;"/>
                    <Label fx:id="lblTotalReservations" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
                    <Label text="Réservations" style="-fx-font-size: 14px; -fx-text-fill: #757575;"/>
                </VBox>
            </GridPane>

            <!-- Actions principales -->
            <Label text="Actions Principales" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                </columnConstraints>

                <Button text="Gérer les Utilisateurs" onAction="#handleGestionUtilisateurs"
                        prefHeight="80" maxWidth="Infinity"
                        style="-fx-background-color: #FF5722; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand; -fx-background-radius: 10;"
                        GridPane.columnIndex="0" GridPane.rowIndex="0"/>

                <Button text="Gérer les Demandes" onAction="#handleGestionDemandes"
                        prefHeight="80" maxWidth="Infinity"
                        style="-fx-background-color: #673AB7; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand; -fx-background-radius: 10;"
                        GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Button text="Gérer les Réservations" onAction="#handleGestionReservations"
                        prefHeight="80" maxWidth="Infinity"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand; -fx-background-radius: 10;"
                        GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                <Button text="🔄 Actualiser les statistiques" onAction="#handleActualiser"
                        prefHeight="60" maxWidth="Infinity"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 10;"
                        GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3"/>
            </GridPane>

        </VBox>
    </center>

</BorderPane>
